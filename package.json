{
  "name": "comic-book-catalogue",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @comic-book-catalogue/db --",
    "db:studio": "turbo run db:studio -F @comic-book-catalogue/db --",
    "db:generate": "turbo run db:generate -F @comic-book-catalogue/db --",
    "db:migrate": "turbo run db:migrate -F @comic-book-catalogue/db --",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && npm run auth:generate",
    "check": "biome check --write ."
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@comic-book-catalogue/config": "*",
    "@types/node": "^26.4.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "varlock": "1.23.0"
  },
  "packageManager": "npm@12.2.0",
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "@prisma/engines": true,
    "prisma": true
  }
}
