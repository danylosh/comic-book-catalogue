{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- npx --yes auth@latest generate --config src/services.ts --output ../../packages/db/prisma/schema/auth.prisma --yes"
  },
  "dependencies": {
    "@comic-book-catalogue/auth": "*",
    "@comic-book-catalogue/db": "*",
    "@comic-book-catalogue/types": "*",
    "@hono/node-server": "^2.1.1",
    "better-auth": "1.7.12",
    "hono": "^4.13.7",
    "hono-openapi": "^1.5.0",
    "http-status-codes": "^2.3.0",
    "varlock": "1.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@comic-book-catalogue/config": "*",
    "@types/node": "^26.4.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
