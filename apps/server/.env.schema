# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
# Generate your own, or just write the same character for 32 times
BETTER_AUTH_SECRET=

# @type=url
# Public URL of this API server. Local dev default: http://localhost:3002
BETTER_AUTH_URL=http://localhost:3002

# @type=url
# Origin of the web app allowed to call this API. Local dev default: http://localhost:3003
CORS_ORIGIN=http://localhost:3003

# @type=string(minLength=1)
# use this db url or choose your own, the name of db should stay the same, can change ports, host name and password
# Local dev default uses the docker compose port mapping (5435) to avoid clashing with other projects
DATABASE_URL=postgresql://postgres:password@localhost:5435/comic-book-catalogue
